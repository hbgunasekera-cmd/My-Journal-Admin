{
  "functions": {
    "api/generate-article.js": {
      "maxDuration": 60
    },
    "api/gemini-batch.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/share-twitter",
      "destination": "/api/share-meta?platform=twitter"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-publish",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-refresh-tokens",
      "schedule": "0 0 1 * *"
    }
  ]
}
